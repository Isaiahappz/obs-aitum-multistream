#!/bin/sh
# Aitum Multistream - installer pre-flight checks.
#
# Refuses the install unless a release build of OBS Studio 33.0.0 or newer is
# on this Mac, asks the operator to quit OBS first, then clears out any older
# copy of the plugin so OBS can never load two of them. Beta and release
# candidate builds of OBS are refused as well, unless
# AITUM_ALLOW_PRERELEASE=1 is set.
#
# Nothing here calls lipo, otool, xcrun or any other Xcode Command Line Tools
# stub: on a Mac without those tools they do not fail quietly, they raise the
# "install the command line developer tools" prompt in front of the volunteer.
#
# Nothing here touches OBS settings: basic/ (profiles, scenes, service.json),
# global.ini, user.ini and plugin_config/ are never read or written. Stream
# keys and saved Aitum outputs live in plugin_config/aitum-multistream and are
# left exactly as they are.
#
# Exiting non-zero aborts the install.

set -u

MIN_VERSION="33.0.0"
MIN_DISPLAY="33.0"
DOWNLOAD_PAGE="https://obsproject.com/download"
# A -beta or -rc build of OBS is a moving target: it can change behaviour from
# one build to the next, and it is not what anyone should be running during a
# service. Those are refused unless whoever is testing asks for them with
# AITUM_ALLOW_PRERELEASE=1, which only reaches these scripts when the package
# is installed from the command line, never from a double-click.
ALLOW_PRERELEASE="${AITUM_ALLOW_PRERELEASE:-0}"
PLUGIN_NAME="aitum-multistream"
OBS_BUNDLE_ID="com.obsproject.obs-studio"
DIALOG_TITLE="Aitum Multistream"
QUIT_WAIT_SECONDS=30

# AppleScript dialog icons. These have to be numbers: handing "stop" to a run
# handler as a string makes AppleScript hunt for an icon resource of that name
# and fail with -192.
ICON_STOP=0
ICON_CAUTION=2

log() { printf '[aitum-multistream preinstall] %s\n' "$*" >&2; }

# --- who to show dialogs to ------------------------------------------------
# A home-directory install runs these scripts as the user, but be ready for a
# root context too, so a dialog is never sent to a session nobody is looking at.
console_user=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || printf '')
case "$console_user" in
	'' | root | loginwindow) console_user='' ;;
esac
console_uid=''
if [ -n "$console_user" ]; then
	console_uid=$(/usr/bin/id -u "$console_user" 2>/dev/null || printf '')
fi

am_root() { [ "$(/usr/bin/id -u)" -eq 0 ]; }

as_user() {
	if am_root && [ -n "$console_uid" ]; then
		/bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" "$@"
	else
		"$@"
	fi
}

# ask MESSAGE ICON BUTTON_A BUTTON_B -> prints the button that was clicked
ask() {
	_msg="$1"
	_icon="$2"
	_a="$3"
	_b="$4"
	as_user /usr/bin/osascript \
		-e 'on run {msg, ttl, icn, btnA, btnB}' \
		-e 'display dialog msg with title ttl buttons {btnA, btnB} default button btnB with icon (icn as integer)' \
		-e 'return button returned of result' \
		-e 'end run' \
		-- "$_msg" "$DIALOG_TITLE" "$_icon" "$_a" "$_b" 2>/dev/null || printf '%s' "$_a"
}

# tell MESSAGE ICON -> single OK button
tell_user() {
	as_user /usr/bin/osascript \
		-e 'on run {msg, ttl, icn}' \
		-e 'display dialog msg with title ttl buttons {"OK"} default button "OK" with icon (icn as integer)' \
		-e 'end run' \
		-- "$1" "$DIALOG_TITLE" "$2" >/dev/null 2>&1 || true
}

# --- where we are installing ----------------------------------------------
# $3 is the install destination; for a home-domain install that is the home
# directory. Fall back to $HOME, then to the console user's home.
target_home=''
if [ "$#" -ge 3 ] && [ -n "${3:-}" ] && [ "$3" != "/" ] && [ -d "$3/Library" ]; then
	target_home="$3"
elif ! am_root && [ -n "${HOME:-}" ] && [ -d "$HOME/Library" ]; then
	target_home="$HOME"
elif [ -n "$console_user" ]; then
	target_home=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory 2>/dev/null |
		/usr/bin/sed -n 's/^NFSHomeDirectory: //p')
fi

if [ -z "$target_home" ] || [ ! -d "$target_home" ]; then
	log "could not work out which home directory to install into"
	tell_user "The installer could not work out where to install. Please sign in as the person who uses OBS and try again." "$ICON_STOP"
	exit 1
fi
log "install home: $target_home"

# --- version arithmetic ----------------------------------------------------
# Compare numerically, so 33.0.0 > 32.2.2 and 33.10.0 > 33.9.0.
version_number() {
	printf '%s\n' "${1:-0}" | /usr/bin/awk -F'[^0-9]+' '
		{ printf "%d\n", ($1 + 0) * 1000000 + ($2 + 0) * 1000 + ($3 + 0) }'
}

# "33.0.0-rc3" and "33.0.0-beta6" both reduce to 33.0.0 above, so the suffix
# has to be looked for in the string itself.
is_prerelease() {
	case "$(printf '%s' "${1:-}" | /usr/bin/tr '[:upper:]' '[:lower:]')" in
		*alpha* | *beta* | *-rc* | *rc[0-9]* | *-dev* | *candidate*) return 0 ;;
		*) return 1 ;;
	esac
}

obs_version_at() {
	_plist="$1/Contents/Info.plist"
	[ -f "$_plist" ] || return 1
	_v=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$_plist" 2>/dev/null)
	if [ -z "$_v" ]; then
		_v=$(/usr/bin/defaults read "$1/Contents/Info" CFBundleShortVersionString 2>/dev/null)
	fi
	[ -n "$_v" ] || return 1
	printf '%s\n' "$_v"
}

# Candidate copies of OBS, most likely first. AITUM_OBS_APP_PATHS replaces the
# list and exists only so the check can be exercised against a stand-in
# OBS.app; Installer.app never sets it.
if [ -n "${AITUM_OBS_APP_PATHS:-}" ]; then
	candidates="$AITUM_OBS_APP_PATHS"
else
	candidates="/Applications/OBS.app
$target_home/Applications/OBS.app"
fi

# The best release build found, and separately the best test build, so a beta
# sitting next to a good release cannot shoulder it aside just by having a
# higher version number.
best_path=''
best_version=''
best_number=0
pre_path=''
pre_version=''
pre_number=0

consider() {
	_app="$1"
	[ -d "$_app" ] || return 0
	_ver=$(obs_version_at "$_app") || {
		log "no CFBundleShortVersionString in $_app"
		return 0
	}
	_num=$(version_number "$_ver")
	if is_prerelease "$_ver"; then
		log "found OBS $_ver at $_app (a test build)"
		if [ "$_num" -gt "$pre_number" ]; then
			pre_path="$_app"
			pre_version="$_ver"
			pre_number="$_num"
		fi
	else
		log "found OBS $_ver at $_app"
		if [ "$_num" -gt "$best_number" ]; then
			best_path="$_app"
			best_version="$_ver"
			best_number="$_num"
		fi
	fi
}

oldIFS="$IFS"
IFS='
'
for app in $candidates; do
	IFS="$oldIFS"
	[ -n "$app" ] && consider "$app"
	IFS='
'
done
IFS="$oldIFS"

# Last resort: Spotlight, in case OBS lives somewhere unusual.
if [ -z "$best_path" ] && [ -z "$pre_path" ] && [ -z "${AITUM_OBS_APP_PATHS:-}" ]; then
	spotlight=$(/usr/bin/mdfind "kMDItemCFBundleIdentifier == '$OBS_BUNDLE_ID'" 2>/dev/null || printf '')
	oldIFS="$IFS"
	IFS='
'
	for app in $spotlight; do
		IFS="$oldIFS"
		case "$app" in
			*/.Trash/* | '') ;;
			*) consider "$app" ;;
		esac
		IFS='
'
	done
	IFS="$oldIFS"
fi

min_number=$(version_number "$MIN_VERSION")

# Asked to, take the test build as if it were a release.
if [ "$ALLOW_PRERELEASE" = "1" ] && [ "$pre_number" -gt "$best_number" ]; then
	log "AITUM_ALLOW_PRERELEASE=1 - accepting the test build OBS $pre_version"
	best_path="$pre_path"
	best_version="$pre_version"
	best_number="$pre_number"
	pre_path=''
	pre_number=0
fi

if [ -z "$best_path" ] || [ "$best_number" -lt "$min_number" ]; then
	if [ "$pre_number" -ge "$min_number" ]; then
		# New enough, but a beta or a release candidate.
		why="OBS $pre_version is a test build"
		message="This Mac has a test version of OBS Studio ($pre_version).

Test versions of OBS change from one week to the next, so the plugin is not installed onto them.

Please install the regular release of OBS Studio $MIN_DISPLAY or newer, then run this installer again."
	elif [ -n "$best_path" ] || [ -n "$pre_path" ]; then
		# Something is here, it is just too old. Name the newest of them.
		if [ "$pre_number" -gt "$best_number" ]; then
			shown_version="$pre_version"
		else
			shown_version="$best_version"
		fi
		why="OBS $shown_version is older than $MIN_VERSION"
		message="This Mac has OBS Studio $shown_version, which is too old for this plugin.

Aitum Multistream needs OBS Studio $MIN_DISPLAY or newer.

Please update OBS Studio, then run this installer again."
	else
		why="OBS not found"
		message="OBS Studio could not be found on this Mac.

Aitum Multistream is an add-on for OBS Studio, so OBS has to be installed first.

Please install OBS Studio $MIN_DISPLAY or newer, then run this installer again."
	fi

	log "$why - blocking install"
	clicked=$(ask "$message" "$ICON_STOP" "Cancel" "Open OBS Download Page")
	if [ "$clicked" = "Open OBS Download Page" ]; then
		as_user /usr/bin/open "$DOWNLOAD_PAGE" >/dev/null 2>&1 || true
	fi
	exit 1
fi

log "OBS $best_version at $best_path meets the $MIN_VERSION minimum"

# --- is OBS open? ----------------------------------------------------------
obs_running() {
	/usr/bin/pgrep -x OBS >/dev/null 2>&1 ||
		/usr/bin/pgrep -f '/OBS\.app/Contents/MacOS/OBS$' >/dev/null 2>&1
}

if obs_running; then
	log "OBS is running"
	clicked=$(ask "OBS Studio is open. It needs to be closed before the plugin can be replaced.

Quitting OBS does not change your scenes or stream keys." "$ICON_CAUTION" "Cancel" "Quit OBS")
	if [ "$clicked" != "Quit OBS" ]; then
		log "operator cancelled at the quit-OBS prompt"
		exit 1
	fi

	# Ask OBS to quit the same way the menu does, so it saves its scenes. We
	# never kill it.
	as_user /usr/bin/osascript -e "tell application id \"$OBS_BUNDLE_ID\" to quit" >/dev/null 2>&1 || true

	waited=0
	while obs_running && [ "$waited" -lt "$QUIT_WAIT_SECONDS" ]; do
		/bin/sleep 1
		waited=$((waited + 1))
	done

	if obs_running; then
		log "OBS is still running after ${QUIT_WAIT_SECONDS}s - blocking install"
		tell_user "OBS Studio is still open. Please quit OBS yourself (OBS menu ▸ Quit OBS), then run this installer again." "$ICON_STOP"
		exit 1
	fi
	log "OBS quit after ${waited}s"
fi

# --- clear out older copies of the plugin ----------------------------------
plugins_dir="$target_home/Library/Application Support/obs-studio/plugins"

# Only ever delete these exact names, under a path that ends in
# obs-studio/plugins. Anything else is refused.
remove_old_copy() {
	_path="$1"
	case "$_path" in
		*"/obs-studio/plugins/$PLUGIN_NAME.plugin" | \
		*"/obs-studio/plugins/$PLUGIN_NAME.plugin.dSYM" | \
		*"/obs-studio/plugins/$PLUGIN_NAME") ;;
		*)
			log "refusing to remove an unexpected path: $_path"
			return 0
			;;
	esac
	[ -e "$_path" ] || return 0
	log "removing older copy: $_path"
	/bin/rm -rf -- "$_path" || {
		log "could not remove $_path"
		tell_user "The installer could not remove the older copy of the plugin at:

$_path

Please remove it by hand, then run this installer again." "$ICON_STOP"
		return 1
	}
}

remove_old_copy "$plugins_dir/$PLUGIN_NAME.plugin" || exit 1
remove_old_copy "$plugins_dir/$PLUGIN_NAME.plugin.dSYM" || exit 1
# Pre-bundle layout: plugins/<name>/bin/<name>.so plus plugins/<name>/data
remove_old_copy "$plugins_dir/$PLUGIN_NAME" || exit 1

# A machine-wide copy would need an administrator to remove, and OBS 33 only
# scans that location on Intel Macs for the old .so layout. Note it in the log
# rather than nagging the operator about something they probably cannot fix.
for stray in \
	"/Library/Application Support/obs-studio/plugins/$PLUGIN_NAME.plugin" \
	"/Library/Application Support/obs-studio/plugins/$PLUGIN_NAME"; do
	[ -e "$stray" ] && log "note: a machine-wide copy is also present at $stray"
done

log "pre-flight checks passed"
exit 0
