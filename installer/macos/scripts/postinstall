#!/bin/sh
# Aitum Multistream - post-install tidy-up and verification.
#
# Confirms the bundle landed where OBS 33 looks for it, strips the quarantine
# flag so OBS is not refused the load, and writes a line to a log the operator
# can be pointed at. OBS settings are never touched.

set -u

PLUGIN_NAME="aitum-multistream"
DIALOG_TITLE="Aitum Multistream"
# Numeric, so AppleScript does not go looking for an icon resource by name.
ICON_STOP=0

log_line() { printf '%s %s\n' "$(/bin/date '+%Y-%m-%d %H:%M:%S')" "$*"; }

console_user=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || printf '')
case "$console_user" in
	'' | root | loginwindow) console_user='' ;;
esac
console_uid=''
if [ -n "$console_user" ]; then
	console_uid=$(/usr/bin/id -u "$console_user" 2>/dev/null || printf '')
fi

am_root() { [ "$(/usr/bin/id -u)" -eq 0 ]; }

as_user() {
	if am_root && [ -n "$console_uid" ]; then
		/bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" "$@"
	else
		"$@"
	fi
}

tell_user() {
	as_user /usr/bin/osascript \
		-e 'on run {msg, ttl, icn}' \
		-e 'display dialog msg with title ttl buttons {"OK"} default button "OK" with icon (icn as integer)' \
		-e 'end run' \
		-- "$1" "$DIALOG_TITLE" "$2" >/dev/null 2>&1 || true
}

target_home=''
if [ "$#" -ge 3 ] && [ -n "${3:-}" ] && [ "$3" != "/" ] && [ -d "$3/Library" ]; then
	target_home="$3"
elif ! am_root && [ -n "${HOME:-}" ] && [ -d "$HOME/Library" ]; then
	target_home="$HOME"
elif [ -n "$console_user" ]; then
	target_home=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory 2>/dev/null |
		/usr/bin/sed -n 's/^NFSHomeDirectory: //p')
fi

bundle="$target_home/Library/Application Support/obs-studio/plugins/$PLUGIN_NAME.plugin"
log_dir="$target_home/Library/Logs"
log_file="$log_dir/Aitum Multistream Installer.log"

/bin/mkdir -p "$log_dir" 2>/dev/null || true
exec 3>>"$log_file" 2>/dev/null || exec 3>/dev/null
say() { log_line "$*" >&3; printf '[aitum-multistream postinstall] %s\n' "$*" >&2; }

if [ ! -d "$bundle" ]; then
	say "FAILED: nothing was installed at $bundle"
	tell_user "Something went wrong: the plugin is not where OBS expects it.

Expected:
$bundle" "$ICON_STOP"
	exit 1
fi

# A quarantine flag on the bundle stops OBS loading it. Packages installed from
# a .pkg normally arrive clean, but strip it either way.
/usr/bin/xattr -dr com.apple.quarantine "$bundle" 2>/dev/null || true

# In a home-domain install these files already belong to the operator; put that
# beyond doubt if a root context ever installed them.
if am_root && [ -n "$console_user" ]; then
	/usr/sbin/chown -R "$console_user" "$bundle" 2>/dev/null || true
fi

version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$bundle/Contents/Info.plist" 2>/dev/null ||
	printf 'unknown')

# --- which architectures are in the bundle? --------------------------------
# `lipo -archs` would answer this in one word, but /usr/bin/lipo is a stub that
# forwards to the Xcode Command Line Tools. On a Mac without them it does not
# just fail - it pops the "install the command line developer tools" prompt,
# which is the last thing a volunteer should be asked mid-install. uname and
# /usr/bin/file are part of macOS itself and never prompt.
#
# `file -b` describes a universal binary on its first line, naming each slice
# in brackets:
#   Mach-O universal binary with 2 architectures: [x86_64:...] [arm64:...]
# and a single-architecture binary as:
#   Mach-O 64-bit bundle arm64
bundle_arches() {
	_bin="$1"
	[ -f "$_bin" ] || {
		printf 'unknown'
		return
	}
	/usr/bin/file -b "$_bin" 2>/dev/null | /usr/bin/sed -n '1p' | /usr/bin/awk '
		/Mach-O universal/ {
			while (match($0, /\[[A-Za-z0-9_.]+:/)) {
				name = substr($0, RSTART + 1, RLENGTH - 2)
				if (!(name in seen)) {
					seen[name] = 1
					list = list (list ? " " : "") name
				}
				$0 = substr($0, RSTART + RLENGTH)
			}
			next
		}
		/Mach-O/ { list = $NF }
		END { printf "%s", (list ? list : "unknown") }'
}

this_arch=$(/usr/bin/uname -m 2>/dev/null || printf 'unknown')
arches=$(bundle_arches "$bundle/Contents/MacOS/$PLUGIN_NAME")

say "installed Aitum Multistream $version at $bundle"
say "this Mac is $this_arch; the plugin was built for: $arches"

# Only speak up when we positively read the slices and this Mac's is not among
# them. Anything we could not parse is logged above and left at that, rather
# than worrying a volunteer over a bundle that is probably fine.
if [ "$arches" != "unknown" ] && [ "$this_arch" != "unknown" ]; then
	case " $arches " in
		*" $this_arch "*) say "architecture check passed" ;;
		*)
			say "WARNING: nothing in this bundle matches $this_arch - OBS will not load it"
			tell_user "This copy of the plugin was not built for this Mac.

This Mac is $this_arch, and the plugin contains: $arches

Please ask for an installer built for this Mac." "$ICON_STOP"
			;;
	esac
fi

say "OBS settings untouched: basic/, global.ini, user.ini and plugin_config/ were not written"

exit 0
